# Anthropic (Claude) API
ANTHROPIC_API_KEY=

# 선택: 기본값은 app/config.py 참고
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_MAX_TOKENS=1024

# 임베딩을 API 기반으로 전환할 경우 (선택)
# VOYAGE_API_KEY=

# ChromaDB 저장 경로
CHROMA_PERSIST_DIR=./data/chroma_db

# 답변의 Faithfulness(신뢰도) 최소 합격 점수 (0.0~1.0). 미달 시 CSM/Support 티켓 리포트 자동 생성
# FAITHFULNESS_THRESHOLD=0.7
